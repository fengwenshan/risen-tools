{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "risen-tools",
  "version": "1.0.0",
  "identifier": "com.risen.tools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8790",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "risen-tools",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQjRFNEIxRUNFRjMzNTMKUldSVE0rL3NzZVMwbk9uRHJ2TENlSVdrMEcvbjJBeTVJTmRPbTk3Q1NmTUF4cERmRWZwMEl6L2oK",
      "endpoints": [
        "https://gitee.com/feng_wenshan/risen-tools/raw/main/updates/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
