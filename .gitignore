# 依赖
node_modules/

# 前端构建产物
dist/

# 构建缓存
.vite/
*.tsbuildinfo

# Rust 构建产物
src-tauri/target/
src-tauri/gen/schemas/

# 发布产物（本地构建出来的安装包与清单）
release/

# 环境变量与签名密钥（切勿提交）
.env
.env.*
*.key
*.key.pub
*.sig

# 本地构建工具链（Rust + MSYS2/MinGW，仅本机验证用，体积很大，切勿提交）
.toolchain/

# pnpm 本地安装产物（pnpm 11 自动生成，含本机专属开关，不参与 CI 构建）
.pnpm-store/
pnpm-workspace.yaml

# 应用本地运行时配置（cwd/.config 是 config.rs 的候选路径之一）
# 里面存着真实 VPN 账号与 profile，等同于机器专属状态，切勿提交
src-tauri/.config/

# 内置 openconnect 的本地留档压缩包：解出来的内容已经在 openconnect/ 目录里，
# 留着只会被打进安装包，白白撑大体积
src-tauri/resources/apps/*.zip

# 编辑器与系统
.DS_Store
.idea/
.vscode/
.trae/
*.log
